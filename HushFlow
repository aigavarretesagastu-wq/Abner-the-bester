import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

void main() {
  runApp(
    ChangeNotifierProvider<UserData>(
      create: (BuildContext context) => UserData(),
      builder: (BuildContext context, Widget? child) => const ScamBlockerApp(),
    ),
  );
}

// DATA_MODEL
class UserData extends ChangeNotifier {
  String _name;
  String _email;
  // In a real application, passwords should never be stored in plain text.
  // They should be hashed and securely stored, and authentication
  // would involve a backend service. For this exercise, it's stored for
  // demonstration of the 'Change Password' feature.
  String _password;

  UserData({String name = '', String email = '', String password = ''})
      : _name = name,
        _email = email,
        _password = password;

  String get name => _name;
  String get email => _email;

  // Method to simulate user login
  // For this exercise, it assumes login is successful if any email/password is provided.
  // In a real app, this would validate against stored credentials.
  void login(String email, String password) {
    _email = email;
    _password = password;
    // _name is intentionally not set here. It's assumed to persist from a previous signup
    // or remain empty if no signup occurred for this session.
    notifyListeners();
  }

  // Method to simulate user signup
  void signup(String name, String email, String password) {
    _name = name;
    _email = email;
    _password = password;
    notifyListeners();
  }

  // Method to change the user's password
  bool changePassword(String currentPassword, String newPassword) {
    if (_password == currentPassword) {
      _password = newPassword;
      notifyListeners();
      return true;
    }
    return false;
  }

  // Method to update user's name and email
  void updateProfile(String newName, String newEmail) {
    _name = newName;
    _email = newEmail;
    notifyListeners();
  }

  // Method to simulate user logout
  void logout() {
    // Keep the name when logging out so it persists across login/logout cycles,
    // reflecting the name used during account creation.
    _email = '';
    _password = '';
    notifyListeners();
  }
}

class ScamBlockerApp extends StatelessWidget {
